#!/usr/bin/env ruby
# git-boot

# 20260821
# 0.16.2

require 'fileutils'

lib_dir = File.expand_path(File.join(__FILE__, '..', '..', 'lib'))
$LOAD_PATH.unshift(lib_dir) unless $LOAD_PATH.include?(lib_dir)

require 'Credentials'
require 'Kernel/require_gem'

# Ahead of octokit rather than beside it: octokit builds its middleware stack upon being required, and retrying is only in the stack if the middleware is registered by then.  Faraday moved it out to a gem of its own at 2.0, and octokit says so upon every run where it is absent.
require_gem 'faraday/retry', gem_name: 'faraday-retry'

require_gem 'impuri'
require_gem 'net/ssh', gem_name: 'net-ssh'
require_gem 'octokit'
require_gem 'switches.rb'
require_gem 'sym'

# require_gem installs what is absent, and an impuri which is present but too old is neither absent nor usable.  Said plainly here rather than left to surface as a NoMethodError from the middle of a push.
abort('git-boot wants impuri 0.12.0 or later, for ImpURI#to_ssh.') unless ImpURI.method_defined?(:to_ssh)

def switches
  @switches ||= Switches.new do |s|
    s.set(:t, :token, :access_token, :personal_access_token)
    s.set(:n, :name, :token_name, :access_token_name)
    s.boolean(:p, :private)
  end
end

def impuri
  ImpURI.new(ARGV[0])
end

def supplied_access_token
  switches.access_token
end

def supplied_unencrypted_access_token_filename
  if switches.token_name
    File.expand_path(File.join('~', '.config', 'github', "#{switches.token_name}.token"))
  end
end

def default_unencrypted_access_token_filename
  Dir[File.expand_path(File.join('~', '.config', 'github', '*.token'))].first
end

def unencrypted_access_token_filename
  supplied_unencrypted_access_token_filename || default_unencrypted_access_token_filename
end

def config_filename
  File.expand_path(File.join('~', '.config', 'github', "config.rb"))
end

# The config file defines constants, so reading it twice is a redefinition warning apiece, and access_token_name is asked for more than once: once to build the label and again to decide whether there is a name at all.  Memoised upon whether it has been read rather than upon what it gave, since a config file which is not there yields nil legitimately and ||= would read it again each time.
def configured_access_token_name
  return @configured_access_token_name if defined?(@configured_access_token_name)
  @configured_access_token_name = access_token_name_from_config
end

def access_token_name_from_config
  return nil unless File.exist?(config_filename)
  eval(File.read(config_filename))
  ACCESS_TOKEN_NAME
end

def access_token_name
  switches.access_token_name || configured_access_token_name
end

def encrypted_access_token_label
  "github.com-#{access_token_name}.token"
end

# Three states, and they are not the same. The store is unreachable when the
# key is not to hand, which is ordinary, so that falls through to the next
# source. A named credential which the store does not hold is a
# misconfiguration, naming it being a statement of intent, so that stops.
def encrypted_access_token
  return nil unless access_token_name
  begin
    credentials = Credentials.find(encrypted_access_token_label)
  rescue SystemCallError
    return nil
  end
  begin
    credentials.token
  rescue NoMethodError
    abort "No such credential: #{encrypted_access_token_label}."
  end
end

def unencrypted_access_token
  return nil unless unencrypted_access_token_filename
  File.read(unencrypted_access_token_filename).strip
end

def access_token
  supplied_access_token || encrypted_access_token || unencrypted_access_token ||
    abort('No access token. Supply one with --token, name one with --name, or place one in ~/.config/github/.')
end

def path_to_repository_with_extension(impuri)
  impuri.path =~ /\.git$/ ? impuri.path : impuri.path + '.git'
end

def entries_to_add
  Dir['*'] + Dir['.*'] - ['.', '..', '.git', '.gitignore']
end

def gitignore_template_path
  File.expand_path(File.join(__FILE__, '..', '..', 'templates', 'gitignore'))
end

# Said here rather than left to write an empty file, which is the fault this template exists to correct and would be the harder one to see for having been corrected once already.  The template ships beside bin and lib, and the Homebrew formula installs all three.
def gitignore_template
  abort("git-boot cannot find its .gitignore template at #{gitignore_template_path}.") unless File.exist?(gitignore_template_path)
  File.read(gitignore_template_path)
end

# The root commit is made unconditionally, so as every real commit has a parent and can be amended, reset onto, or rebased in the ordinary way.  A root commit has none, and so needs --orphan or --root to rewrite.
# The template is written only where no .gitignore is there already: one which is already in the directory is the repository's own, whatever it holds, and is committed as it stands rather than replaced.
def create_root_commit
  File.write('.gitignore', gitignore_template) unless File.exist?('.gitignore')
  system "git add .gitignore"
  system "git commit -m '+ .gitignore'"
end

# Everything present can be ignored by the template and still be an entry to add, the count being of what is in the directory rather than of what git will take.  git diff --cached --quiet exits 0 where nothing is staged, which is the case to leave alone rather than ask git to commit and be told there is nothing to.
def add_entries
  return if entries_to_add.empty?
  system "git add ."
  return if system('git', 'diff', '--cached', '--quiet')
  system "git commit -m '+ *'"
end

def has_commits?
  system('git', 'rev-parse', '--quiet', '--verify', 'HEAD', out: File::NULL, err: File::NULL)
end

# What distinguishes a repository to be booted is that it has no commits, not that it has no .git: a directory which has been git init'd and left alone still wants the whole treatment.  A repository with history has its own root commit already, whatever that is, and grafting another onto the tip neither gives it a parent nor is wanted.
def create_local_repo
  return if has_commits?
  system "git init" unless File.exist?('.git')
  create_root_commit
  add_entries
end

# One command rather than a shell session: git takes the path itself, so the mkdir and the cd which needed a session to hold the working directory between them are not wanted.  The session came from net-ssh-shell, which pins net-ssh to ~> 2.1.0, and 2.1.4 offers only SHA-1 key exchange and ssh-rsa host keys, neither of which a current server will negotiate.
def create_remote_repo
  Net::SSH.start(impuri.host, impuri.username, password: impuri.password) do |ssh|
    ssh.exec!("git init --bare #{path_to_repository_with_extension(impuri)}")
  end
end

# An unsupplied boolean switch reads as nil rather than false, and the API wants the field either way, so it is made a boolean here rather than passed as it comes.  Creating a private repository needs a token with the whole repo scope; public_repo alone is refused.
def create_remote_github_repo
  repository_name = File.basename(impuri.path, '.git')
  octokit_client = Octokit::Client.new(access_token: access_token)
  octokit_client.create_repository(repository_name, private: !!switches.private?)
end

def origin_url
  url = `git remote get-url origin 2>/dev/null`.strip
  url.empty? ? nil : url
end

# Checked before anything remote is made, rather than when the push fails, so as a refusal leaves neither an empty repository on the far end nor a remote pointing somewhere unintended.  How many remotes a repository keeps is its own business; what cannot be allowed is pushing to one which was not named here.
def ensure_origin_is_free
  return unless origin_url
  abort("This repository already has a remote named origin: #{origin_url}. Remove or rename it, or add the second remote by hand.")
end

def github?
  impuri.hostname == 'github.com'
end

# ImpURI#impuri returns a fresh object apiece, so what is mutated here is nobody else's.  Github wants the git user whatever was named on the command line, and the repository is made with a .git extension, so it is pushed to with one: the two had been left to differ, and an ssh repository created as thing.git was then pushed to as thing.
def remote_uri
  remote = impuri
  remote.username = 'git' if github?
  remote.path = path_to_repository_with_extension(remote)
  remote.to_ssh
end

def push_to_remote_repo(uri = remote_uri)
  system('git', 'remote', 'add', 'origin', uri)
  system('git', 'push', '--follow-tags', 'origin', 'HEAD')
end

def main
  create_local_repo
  switches # The switches need to be processed first in order for the URL to be left as the remaining entry in ARGV.
  if ARGV[0]
    ensure_origin_is_free
    github? ? create_remote_github_repo : create_remote_repo
    push_to_remote_repo
  end
end

# Run when run, and not when required.  Requiring it is what lets the parts no subprocess can reach be called directly: everything from remote_uri onwards sits behind either a Github token or a live ssh host.
main if $PROGRAM_NAME == __FILE__
